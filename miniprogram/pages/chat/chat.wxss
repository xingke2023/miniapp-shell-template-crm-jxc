.root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F8F2ED;
}

/* Header */
.header {
  background: linear-gradient(135deg, #1565C0 0%, #0D47A1 100%);
  flex-shrink: 0;
}
.header-inner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 30rpx;
}
.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.avatar-svg { width: 48rpx; height: 48rpx; }
.title-block { flex: 1; min-width: 0; }
.title {
  color: #fff;
  font-weight: 400;
  font-size: 40rpx;
  line-height: 1.2;
}
.subtitle {
  color: rgba(255,255,255,0.78);
  font-size: 26rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  background: #7fff7f;
  border-radius: 50%;
}
.logout-link {
  color: #fff;
  text-decoration: underline;
  font-size: 26rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.logout-link:active { opacity: 0.6; }
.header-username {
  font-weight: 600;
  color: #fff;
}
.header-tagline {
  color: rgba(255,255,255,0.70);
  font-size: 24rpx;
  margin-top: 6rpx;
  line-height: 1.4;
}

.size-toggle {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(0,0,0,0.18);
  border-radius: 16rpx;
  padding: 4rpx 8rpx;
  margin-right: 188rpx;
  margin-top: -38rpx;
}
.size-btn {
  color: #fff;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  line-height: 1;
}
.size-btn-active { background: rgba(255,255,255,0.3); }

/* Messages */
.msgs {
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
  width: 100%;
}
.row {
  display: flex;
  margin-bottom: 20rpx;
}
.row-user { justify-content: flex-end; }
.row-ai { justify-content: flex-start; }


.bubble {
  max-width: 78%;
  padding: 18rpx 26rpx;
  border-radius: 30rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}
.bubble-ai {
  background: #fff;
  color: #2A1F19;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(230,92,70,0.10);
}
.bubble-user {
  background: #E65C46;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.font-sm { font-size: 24rpx; }
.font-md { font-size: 28rpx; }
.font-lg { font-size: 32rpx; }

/* ─ Markdown 块级渲染（AI 气泡内部） ─────────────────────── */
.md-p {
  margin: 6rpx 0;
}
.md-p:first-child { margin-top: 0; }
.md-p:last-child  { margin-bottom: 0; }

.md-h {
  margin: 14rpx 0 8rpx;
  font-weight: 700;
}
.md-h-1 { font-size: 1.30em; }
.md-h-2 { font-size: 1.18em; }
.md-h-3 { font-size: 1.08em; }
.md-h:first-child { margin-top: 0; }

/* 列表项：flex 行布局，左侧固定宽度 marker 区，右侧文字自适应 */
.md-li {
  display: flex;
  align-items: flex-start;
  margin: 6rpx 0;
}
.md-marker {
  flex-shrink: 0;
  text-align: right;
  padding-right: 14rpx;
  line-height: 1.55;
}
.md-marker-num { color: #2A1F19; font-weight: 600; }
.md-marker-dot { color: #E65C46; font-weight: 700; }
.md-li-text {
  flex: 1;
  min-width: 0;
  line-height: 1.55;
}

/* 动作卡片（仿微信服务通知 / 客服消息样式） */
.ac-card {
  margin: 12rpx 0;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  border: 1rpx solid #EAEAEA;
}
.ac-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx 16rpx;
}
.ac-card-icon {
  font-size: 40rpx;
  line-height: 1;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2F2F2;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.ac-card-titles { flex: 1; min-width: 0; }
.ac-card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #191919;
  line-height: 1.35;
}
.ac-card-subtitle {
  font-size: 24rpx;
  color: #888888;
  margin-top: 6rpx;
}
.ac-card-fields {
  padding: 4rpx 28rpx 16rpx;
}
.ac-card-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10rpx 0;
  gap: 20rpx;
}
.ac-card-label {
  font-size: 26rpx;
  color: #888888;
  flex-shrink: 0;
}
.ac-card-value {
  font-size: 28rpx;
  color: #191919;
  text-align: right;
  flex: 1;
  word-break: break-all;
}
.ac-card-body {
  padding: 0 28rpx 20rpx;
  font-size: 28rpx;
  color: #353535;
  line-height: 1.6;
}

/* 微信风格底部按钮行：白底、上分割线、按钮间垂直分割线 */
.ac-card-actions {
  display: flex;
  border-top: 1rpx solid #EAEAEA;
}
.ac-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  padding: 28rpx 16rpx;
  line-height: 1;
  background: #FFFFFF;
  color: #576B95;       /* 微信链接蓝 */
  border-right: 1rpx solid #EAEAEA;
  transition: background 0.12s;
}
.ac-btn:last-child { border-right: none; }
.ac-btn:active { background: #F5F5F5; }

.ac-btn-primary { color: #07C160; font-weight: 500; }  /* 微信绿 */
.ac-btn-ghost   { color: #576B95; }                    /* 微信链接蓝 */
.ac-btn-danger  { color: #FA5151; }                    /* 警告红 */


/* 代码块 */
.md-code {
  margin: 8rpx 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(42,31,25,0.08);
  font-family: monospace;
  font-size: 0.88em;
  white-space: pre-wrap;
  word-break: break-all;
  overflow-x: auto;
}

/* Typing */
.typing-bubble {
  background: #fff;
  border-radius: 30rpx;
  border-bottom-left-radius: 8rpx;
  padding: 20rpx 26rpx;
  display: flex;
  gap: 8rpx;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(42,31,25,0.10);
}
.dot-anim {
  width: 12rpx;
  height: 12rpx;
  background: #E65C46;
  border-radius: 50%;
  animation: clawBounce 1.2s infinite;
}
.dot-1 { animation-delay: 0.2s; }
.dot-2 { animation-delay: 0.4s; }
@keyframes clawBounce {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-10rpx); }
}

/* Bottom panel */
.bottom {
  flex-shrink: 0;
  background: #fff;
  border-top: 1rpx solid rgba(42,31,25,0.10);
  padding: 16rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.input-area {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.input-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 0 24rpx;
}
.input {
  flex: 1;
  background: #FDF8F5;
  border: 3rpx solid rgba(42,31,25,0.18);
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #2A1F19;
  box-sizing: border-box;
  height: 72rpx;
  line-height: 1.4;
}

/* 缩小的发送按钮：圆形 72rpx，箭头图标 */
.btn-send-mini {
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: #E65C46;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 12rpx rgba(230,92,70,0.30);
  transition: transform 0.1s, opacity 0.15s;
}
.btn-send-mini:active { transform: scale(0.96); }
.btn-send-mini--off {
  background: rgba(230,92,70,0.30);
  box-shadow: none;
}

/* Quick action chips menu */
.quick-actions {
  width: 100%;
  white-space: nowrap;
}
.qa-strip {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 14rpx;
}
.qa-chip {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #F8F2ED;
  border: 2rpx solid rgba(42,31,25,0.12);
  border-radius: 32rpx;
  padding: 18rpx 22rpx;
  font-size: 32rpx;
  color: #2A1F19;
  flex-shrink: 0;
  transition: background 0.12s, border-color 0.12s, transform 0.1s;
}
.qa-chip:active { background: rgba(230,92,70,0.08); border-color: #E65C46; transform: scale(0.96); }
.qa-chip--pressed {
  background: rgba(230,92,70,0.13);
  border-color: #E65C46;
  transform: scale(0.94);
}
.qa-emoji { font-size: 28rpx; line-height: 1; }
.qa-chip-icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.qa-home-icon { width: 36rpx; height: 36rpx; }
.qa-label { font-weight: 400; line-height: 1; }
.qa-arrow { font-size: 28rpx; line-height: 1; margin-left: 4rpx; opacity: 0.55; display: inline-block; transition: transform 0.2s; }
.qa-arrow--open { transform: rotate(90deg); opacity: 0.9; }
.qa-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #E65C46;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  box-shadow: 0 0 0 2rpx #fff;
}

/* + / 🎤 圆形小图标按钮 */
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F8F2ED;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid rgba(42,31,25,0.10);
  transition: background 0.15s, transform 0.1s;
}
.icon-btn:active { transform: scale(0.92); background: rgba(230,92,70,0.10); }
.icon-emoji { font-size: 36rpx; line-height: 1; color: #2A1F19; }
.icon-svg { width: 40rpx; height: 40rpx; }

/* 按住说话条 */
.hold-to-talk {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: #F8F2ED;
  border: 2rpx solid rgba(42,31,25,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #2A1F19;
  transition: background 0.12s;
}
.hold-to-talk--rec {
  background: rgba(230,92,70,0.16);
  border-color: #E65C46;
  color: #E65C46;
}

/* + 展开的媒体面板 */
.plus-grid {
  display: flex;
  padding: 20rpx 24rpx 4rpx;
  gap: 28rpx;
  flex-wrap: wrap;
}
.plus-item {
  width: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.plus-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #F8F2ED;
  border: 2rpx solid rgba(42,31,25,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: transform 0.1s, background 0.15s;
}
.plus-item:active .plus-icon { transform: scale(0.94); background: rgba(230,92,70,0.06); border-color: #E65C46; }
.plus-icon-svg { width: 56rpx; height: 56rpx; }
.plus-label { font-size: 24rpx; color: #2A1F19; }

/* ─ Popover：锚定在 quick-action chip 上方 ─────────── */
.popover-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: transparent;
  z-index: 100;
}
.popover {
  position: fixed;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(42,31,25,0.18), 0 2rpx 8rpx rgba(42,31,25,0.06);
  padding: 8rpx 0;
  transform-origin: bottom center;
  animation: popover-in 0.16s cubic-bezier(0.22, 0.61, 0.36, 1);
}
@keyframes popover-in {
  from { opacity: 0; transform: translateY(8rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0)     scale(1);    }
}
.popover-arrow {
  position: absolute;
  bottom: -10rpx;
  width: 20rpx;
  height: 20rpx;
  background: #fff;
  transform: translateX(-50%) rotate(45deg);
  box-shadow: 4rpx 4rpx 8rpx rgba(42,31,25,0.06);
}
.popover-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  transition: background 0.12s;
}
.popover-item + .popover-item {
  border-top: 1rpx solid rgba(42,31,25,0.06);
}
.popover-item:active {
  background: rgba(230,92,70,0.08);
}
.popover-item-emoji {
  font-size: 36rpx;
  line-height: 1;
  width: 52rpx;
  text-align: center;
  flex-shrink: 0;
}
.popover-item-icon-svg {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.popover-item-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.popover-item-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2A1F19;
  line-height: 1.2;
}
.popover-item-desc {
  font-size: 22rpx;
  color: rgba(42,31,25,0.55);
  line-height: 1.3;
}

/* ─ 媒体气泡 ─────────────────────────────────────── */
.media-image {
  position: relative;
  width: 360rpx;
  min-height: 200rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #F8F2ED;
  box-shadow: 0 2rpx 6rpx rgba(42,31,25,0.10);
}
.media-image-thumb {
  width: 360rpx;
  display: block;
  min-height: 200rpx;
}
.media-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.media-overlay--error { background: rgba(210,47,47,0.7); }

.media-file {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #E65C46;
  color: #fff;
  border-radius: 24rpx;
  border-bottom-right-radius: 8rpx;
  padding: 18rpx 22rpx;
  max-width: 78%;
}
.media-file-icon { font-size: 44rpx; flex-shrink: 0; }
.media-file-meta { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.media-file-name {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 380rpx;
}
.media-file-sub { font-size: 22rpx; opacity: 0.8; }

.media-voice {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #E65C46;
  color: #fff;
  border-radius: 36rpx;
  border-bottom-right-radius: 12rpx;
  padding: 18rpx 26rpx;
  max-width: 60%;
}
.media-voice-icon { font-size: 32rpx; }
.media-voice-bar { flex: 1; height: 8rpx; background: rgba(255,255,255,0.35); border-radius: 4rpx; overflow: hidden; }
.media-voice-bar-fill { height: 100%; width: 60%; background: #fff; }
.media-voice-duration { font-size: 24rpx; min-width: 70rpx; text-align: right; }

/* legacy: keep .btn-send for any older paths */
.btn-send {
  background: #E65C46;
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
  border-radius: 20rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 0;
}
.btn-send[disabled] {
  background: rgba(230,92,70,0.30);
  color: #fff;
}

/* ─ 全屏登录页 ──────────────────────────────────────── */
/* ─ 全屏登录页（淡色系） ─────────────────────────────── */
.login-screen {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 500;
  background: linear-gradient(160deg, #FFF4EF 0%, #FDEAE3 55%, #FFF9F6 100%);
  overflow: hidden;
}
.ls-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.ls-glow-a {
  width: 700rpx; height: 700rpx;
  top: -300rpx; right: -220rpx;
  background: radial-gradient(circle at center, rgba(230,92,70,0.14) 0%, rgba(230,92,70,0) 68%);
}
.ls-glow-b {
  width: 560rpx; height: 560rpx;
  bottom: -220rpx; left: -160rpx;
  background: radial-gradient(circle at center, rgba(230,92,70,0.09) 0%, rgba(230,92,70,0) 68%);
}
.ls-inner {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: calc(env(safe-area-inset-top) + 40rpx) 48rpx calc(env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
  overflow-y: auto;
}
.ls-inner-center {
  gap: 40rpx;
}

/* 品牌区 */
.ls-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}
.ls-logo {
  width: 148rpx; height: 148rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E65C46 0%, #c9402a 100%);
  box-shadow: 0 10rpx 36rpx rgba(230,92,70,0.35), 0 0 0 14rpx rgba(230,92,70,0.10), 0 0 0 28rpx rgba(230,92,70,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  flex-shrink: 0;
}
.ls-logo-img { width: 90rpx; height: 90rpx; }
.ls-logo-pulse { animation: ls-pulse 2.2s ease-in-out infinite; }
@keyframes ls-pulse {
  0%, 100% { box-shadow: 0 10rpx 36rpx rgba(230,92,70,0.35), 0 0 0 14rpx rgba(230,92,70,0.10), 0 0 0 28rpx rgba(230,92,70,0.05); }
  50%       { box-shadow: 0 10rpx 48rpx rgba(230,92,70,0.45), 0 0 0 22rpx rgba(230,92,70,0.14), 0 0 0 44rpx rgba(230,92,70,0.06); }
}
.ls-brand-name {
  color: #2A1F19;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
}
.ls-brand-sub {
  color: rgba(42,31,25,0.42);
  font-size: 26rpx;
  margin-top: 14rpx;
  letter-spacing: 7rpx;
}

/* 表单卡片 */
.ls-card {
  width: 100%;
  background: #FFFFFF;
  border: 1rpx solid rgba(42,31,25,0.06);
  border-radius: 40rpx;
  padding: 52rpx 44rpx 44rpx;
  box-shadow: 0 12rpx 48rpx rgba(230,92,70,0.12), 0 2rpx 8rpx rgba(42,31,25,0.06);
}
.ls-card-title {
  display: block;
  color: #2A1F19;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 8rpx;
}
.ls-card-desc {
  display: block;
  color: rgba(42,31,25,0.42);
  font-size: 26rpx;
  margin-bottom: 44rpx;
}

/* 输入框组 */
.ls-field-group {
  background: #FDF8F5;
  border: 1rpx solid rgba(42,31,25,0.08);
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.ls-field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 28rpx;
  min-height: 112rpx;
}
.ls-field-icon { width: 36rpx; height: 36rpx; opacity: 0.45; flex-shrink: 0; }
.ls-field-input { flex: 1; height: 112rpx; color: #2A1F19; font-size: 30rpx; background: transparent; }
.ls-ph { color: #c0a898; font-size: 28rpx; }
.ls-field-divider { height: 1rpx; background: rgba(42,31,25,0.08); margin-left: 84rpx; }

/* 提交按钮 */
.ls-btn {
  width: 100%;
  height: 102rpx;
  background: linear-gradient(135deg, #E65C46 0%, #c0341c 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 28rpx;
  border: none;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 32rpx rgba(230,92,70,0.40);
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0;
}
.ls-btn:active { opacity: 0.88; }
.ls-btn[disabled] { opacity: 0.36; box-shadow: none; }

/* 切换注册 */
.ls-toggle {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #E65C46;
}
.ls-toggle:active { opacity: 0.6; }

/* 底部说明 */
.ls-footer {
  display: block;
  margin-top: 48rpx;
  font-size: 22rpx;
  color: rgba(42,31,25,0.28);
  letter-spacing: 3rpx;
  text-align: center;
}

/* 登录中文字 */
.ls-loading-txt {
  display: block;
  color: rgba(42,31,25,0.60);
  font-size: 30rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

/* Hero 欢迎卡 */
.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  margin: 16rpx 0 24rpx;
}
.hero-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.hero-deco-tr {
  width: 340rpx;
  height: 340rpx;
  top: -120rpx;
  right: -90rpx;
  background: rgba(255, 255, 255, 0.10);
}
.hero-deco-tl {
  width: 160rpx;
  height: 160rpx;
  top: -50rpx;
  left: 40rpx;
  background: rgba(255, 255, 255, 0.06);
}
.hero-deco-br {
  width: 260rpx;
  height: 260rpx;
  bottom: -90rpx;
  right: -50rpx;
  background: rgba(0, 0, 0, 0.08);
}
.hero-inner {
  position: relative;
  padding: 40rpx 44rpx 44rpx;
  z-index: 1;
}
.hero-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.hero-date {
  color: rgba(255, 255, 255, 0.45);
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
  margin-top: 20rpx;
  text-align: right;
}
.hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}
.hero-avatar-img {
  width: 50rpx;
  height: 50rpx;
}
.hero-greeting {
  flex: 1;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}
.hero-tagline {
  display: flex;
  align-items: center;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 400;
  background: rgba(0, 0, 0, 0.12);
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
}

/* 主页快捷按钮行 */
.shortcuts-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 12rpx 0 4rpx;
  margin-bottom: 12rpx;
}
.shortcut-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #E8F4FF;
  border-radius: 50rpx;
  padding: 22rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(56,132,220,0.32);
}
.shortcut-chip--pressed { opacity: 0.6; }
.shortcut-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}
.shortcut-icon-fallback {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}
.shortcut-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A6DB5;
  white-space: nowrap;
}
